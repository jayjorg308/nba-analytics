# Record-store connection (ADR-0080). Copy this file to .env (gitignored)
# and replace the placeholder with the real Neon connection string, from the
# Neon console's "Connection string" panel (psycopg/SQLAlchemy form). A real
# NBA_DB_URL environment variable always wins over this file; tests never
# read it (they run their own ephemeral Dockerized Postgres).
NBA_DB_URL=postgresql://USER:PASSWORD@YOUR-NEON-HOST/neondb?sslmode=require
